# Copy to .env.local. No credentials are needed for the static foundation page.
# Required only when a Supabase client is created. Use local development values.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# Replace with the local sb_publishable_... value from supabase status.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional, SERVER-ONLY. Never add NEXT_PUBLIC_ to these names.
# Neither user-scoped Supabase client uses the secret key.
SUPABASE_SECRET_KEY=
OPENAI_API_KEY=
LIVEBLOCKS_SECRET_KEY=
DAILY_API_KEY=
RESEND_API_KEY=
# Server-only verified sender; required only for explicitly invoked email sends.
RESEND_FROM_EMAIL=

# Server-only trusted origin for recovery email redirects. HTTPS in deployment.
AUTH_SITE_URL=http://localhost:3000

# Upload-signing abuse protection only; not storage/pricing quotas.
FICI_UPLOAD_RATE_USER_LIMIT=60
FICI_UPLOAD_RATE_SOURCE_LIMIT=300
FICI_UPLOAD_RATE_WINDOW_SECONDS=60
# Set only behind a trusted proxy that overwrites this header with one client IP.
# Missing/invalid configured IP fails closed. Without it, the user limit applies.
# FICI_UPLOAD_RATE_IP_HEADER=x-real-ip
# Rejections expose code RATE_LIMIT, status 429, retryAfterSeconds and Retry-After
# for HTTP adapters; requestUpload currently has no dedicated HTTP route.
